# Copy this file to .env and adjust values as needed.
# All settings have sensible defaults (see app/config/settings.py),
# so a .env file is optional in development.

APP_NAME=MarineGuard Secure Maritime Platform
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed origins, or * for any origin.
CORS_ALLOW_ORIGINS=*

# PostgreSQL connection URL using the asyncpg driver. The app's async
# engine requires the +asyncpg suffix; Alembic automatically swaps this
# for the sync psycopg driver when running migrations (see
# app/config/settings.py's sync_database_url property) - you don't need
# a second URL for that.
DATABASE_URL=postgresql+asyncpg://marineguard:marineguard@localhost:5432/marineguard

# Echoes every SQL statement to the application log when true. Useful for
# debugging query behavior; noisy, leave false in production.
SQL_ECHO=false

LOG_LEVEL=INFO
